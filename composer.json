{
  "name": "snailtheme/wp-starter-toolkit",
  "description": "Developer toolkit for ST WP Starter core updates, UI profiles, curated blocks, and reusable components.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://www.snailtheme.com/",
  "require": {
    "composer/semver": "^3.4",
    "php": ">=8.1",
    "symfony/console": "^6.4 || ^7.0",
    "symfony/filesystem": "^6.4 || ^7.0",
    "symfony/finder": "^6.4 || ^7.0",
    "symfony/process": "^6.4 || ^7.0"
  },
  "autoload": {
    "psr-4": {
      "SnailTheme\\WPStarterToolkit\\": "src/"
    }
  },
  "bin": [
    "bin/st-toolkit"
  ],
  "scripts": {
    "test:acceptance": [
      "@php tests/acceptance.php",
      "@php tests/bundles.php",
      "@php tests/schema.php",
      "@php tests/elementals-harness-safety.php",
      "@php tests/agent-docs.php"
    ],
    "test:bundles": "@php tests/bundles.php",
    "test:elementals-harness": "@php tests/elementals-harness-safety.php",
    "test:agent-docs": "@php tests/agent-docs.php"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
